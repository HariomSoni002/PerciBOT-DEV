{
  "eula": "",
  "license": "",
  "vendor": "HS",
  "id": "com.percipere.sac.percibot.dev",
  "version": "1.0.1",
  "name": "PerciBOT_tataC",
  "newInstancePrefix": "PerciBOT_TataC",
  "description": "This is to test the UI changes. NOT FOR DEMO OR PRODUCTION.",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "perci-bot",
      "url": "https://HariomSoni002.github.io/PerciBOT-DEV/src/chat-widget.js",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "builder",
      "tag": "perci-bot-builder",
      "url": "https://HariomSoni002.github.io/PerciBOT-DEV/src/builder.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "width": {
      "type": "integer",
      "default": 1
    },
    "height": {
      "type": "integer",
      "default": 1
    },
    "apiKey": {
      "type": "string",
      "default": ""
    },
    "model": {
      "type": "string",
      "default": "gpt-4o-mini"
    },
    "systemPrompt": {
      "type": "string",
      "default": ""
    },
    "welcomeText": {
      "type": "string",
      "default": "Hello, I'm PerciBOT! How can I assist you today?"
    },
    "primaryColor": {
      "type": "string",
      "default": "#1f4fbf"
    },
    "primaryDark": {
      "type": "string",
      "default": "#163a8a"
    },
    "accentColor": {
      "type": "string",
      "default": "#3cc0ff"
    },
    "surfaceColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "surfaceAlt": {
      "type": "string",
      "default": "#f6f8ff"
    },
    "textColor": {
      "type": "string",
      "default": "#0b1221"
    },
    "datasets": {
      "type": "string",
      "default": ""
    },
    "answerPrompt": {
      "type": "string",
      "default": ""
    },
    "behaviourPrompt": {
      "type": "string",
      "default": ""
    },
    "schemaPrompt": {
      "type": "string",
      "default": ""
    },
    "clientId": {
      "type": "string",
      "default": ""
    },
    "schemaName": {
      "type": "string",
      "default": ""
    },
    "viewName": {
      "type": "string",
      "default": ""
    },
    "memoryMode": {
      "type": "string",
      "default": "disabled"
    }
  },
  "methods": {
    "setDatasets": {
      "description": "Attach datasets (JSON string with { name:{schema,types,rows2D}... }).",
      "parameters": [
        {
          "name": "payload",
          "type": "string",
          "description": "datasets (JSON string with { name:{schema,types,rows2D}... })."
        }
      ],
      "body": "this.datasets = payload;"
    }
  },
  "events": {}
}